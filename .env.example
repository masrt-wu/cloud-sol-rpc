# Copy to .env in the application's working directory. Never commit .env.
# Configure exactly ONE key format. Values below are intentionally empty.
SOLANA_PRIVATE_KEY_BASE58=
SOLANA_SECRET_KEY_JSON=
# Separate wallets used by specific legacy examples; no fallback to another wallet.
SOLANA_PUMP_V3_PRIVATE_KEY_BASE58=
SOLANA_PUMP_ALTERNATE_PRIVATE_KEY_BASE58=
SOLANA_ATA_PRIVATE_KEY_BASE58=

SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com
SOLANA_ACCOUNT=
SOLANA_RECIPIENT=
SOLANA_POOL=
AMOUNT_LAMPORTS=
AMOUNT_IN_RAW=
MIN_OUT_RAW=

# Optional, separate historical offline regression fixtures. Never use a funded wallet.
# Tests requiring a fixture are skipped when that fixture is not configured.
TEST_ACCOUNT_PRIVATE_KEY_BASE58=
TEST_EQUALITY_PRIVATE_KEY_BASE58=
TEST_ACCOUNT_SECRET_KEY_JSON=
TEST_MNEMONIC_BIP44=
TEST_MNEMONIC_LEGACY=
TEST_MNEMONIC_BIP39=
# Authenticated endpoint URLs used by the legacy Pump trading examples.
HELIUS_RPC_URL=
JITO_AUTH_RPC_URL=
# Optional passphrase for the historical mnemonic regression fixture.
TEST_MNEMONIC_PASSPHRASE=

# Maven Central publishing only; these are not GitHub or Solana wallet credentials.
CENTRAL_TOKEN_USERNAME=
CENTRAL_TOKEN_PASSWORD=
# Optional full public fingerprint for selecting a local GPG signing key.
GPG_KEYNAME=
# Optional; leave empty to use interactive GPG Agent signing.
MAVEN_GPG_PASSPHRASE=
